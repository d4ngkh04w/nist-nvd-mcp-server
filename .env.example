# Example environment file for the NVD/NIST MCP server.
#
# Copy this file to `.env` and adjust what you need. Every variable is optional
# and falls back to the built-in default when unset. Real environment variables
# take precedence over values loaded from `.env`.
#
# NVD_API_KEY is optional. Without a key the public NVD API allows roughly
# 5 requests per 30 seconds; with a key the quota is higher. The key is sent
# only through the `apiKey` HTTP header, is never logged and is never written
# into the SQLite or JSON cache.
#
# CURSOR_SECRET is optional and must be at least 16 characters when set. It is
# the HMAC key that signs the opaque pagination cursors; when unset, the server
# generates a random per-process secret at startup, so cursors stop working
# after a restart.
#
# Every *_CACHE_TTL_SECONDS value is a freshness window in seconds. Expired
# entries are refreshed from NVD; if NVD is unavailable the stale copy is still
# served with a warning in `meta.warnings` (`cacheStatus: "stale_fallback"`).
#
# Additional supported overrides (commented out at the end of this file, with
# their built-in defaults): NVD_RETRY_BASE_DELAY_MS=1000,
# SQLITE_BUSY_TIMEOUT_MS=500, MAX_NVD_START_INDEX=100000,
# CACHE_MAX_ENTRY_BYTES=4000000, DATA_DIRECTORY, MIGRATIONS_DIRECTORY,
# CURSOR_SECRET and CPE_SEARCH_CACHE_TTL_SECONDS=86400.

# --- NVD API -----------------------------------------------------------------

NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json

# --- NVD request pacing, timeout and retries ---------------------------------

NVD_MIN_INTERVAL_MS=6000
NVD_MAX_CONCURRENCY=1
NVD_REQUEST_TIMEOUT_MS=15000
NVD_MAX_RETRIES=4

# --- Storage -----------------------------------------------------------------

SQLITE_PATH=./data/nvd.sqlite
CACHE_DIRECTORY=./data/cache

# --- Cache TTLs (seconds) ----------------------------------------------------

CVE_CACHE_TTL_SECONDS=86400
SEARCH_CACHE_TTL_SECONDS=900
RECENT_CACHE_TTL_SECONDS=300
MODIFIED_CACHE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=3600
CPE_CACHE_TTL_SECONDS=604800
CPE_MATCH_CACHE_TTL_SECONDS=86400

# --- Pagination --------------------------------------------------------------

CURSOR_TTL_SECONDS=1800
MAX_CVE_PAGE_SIZE=50
MAX_HISTORY_PAGE_SIZE=50
MAX_CPE_PAGE_SIZE=100
MAX_CPE_MATCH_PAGE_SIZE=100

# --- Cache maintenance, logging, runtime -------------------------------------

CACHE_MAX_SIZE_MB=1024
CACHE_CLEANUP_INTERVAL_SECONDS=3600
LOG_LEVEL=info
NODE_ENV=production

# --- Optional overrides ------------------------------------------------------
# Uncomment and edit a line to activate it. Defaults are shown.
#
# NVD_RETRY_BASE_DELAY_MS=1000
# SQLITE_BUSY_TIMEOUT_MS=500
# MAX_NVD_START_INDEX=100000
# CACHE_MAX_ENTRY_BYTES=4000000
# DATA_DIRECTORY=
# MIGRATIONS_DIRECTORY=
# CURSOR_SECRET=
# CPE_SEARCH_CACHE_TTL_SECONDS=86400
# MAX_DATE_RANGE_DAYS=120
# MAX_CVE_IDS_PER_REQUEST=100
#
# Meaning of each override:
#   NVD_RETRY_BASE_DELAY_MS      base delay in ms for exponential retry backoff
#   SQLITE_BUSY_TIMEOUT_MS       SQLite busy-handler timeout in ms
#   MAX_NVD_START_INDEX          reject pagination offsets larger than this value
#   CACHE_MAX_ENTRY_BYTES        maximum size in bytes of a single cache entry
#   DATA_DIRECTORY               root directory for default SQLITE_PATH/CACHE_DIRECTORY
#   MIGRATIONS_DIRECTORY         SQL migration directory (default ./migrations)
#   CURSOR_SECRET                HMAC secret (>= 16 chars) for pagination cursors
#   CPE_SEARCH_CACHE_TTL_SECONDS TTL for CPE dictionary search responses
#   MAX_DATE_RANGE_DAYS          maximum date window (capped at the NVD limit of 120 days)
#   MAX_CVE_IDS_PER_REQUEST      maximum identifiers in one get_cves call (NVD limit: 100)
